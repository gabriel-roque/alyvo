# Application
APP_ENV=development
APP_SECRET=change-me-in-production

# Database
DATABASE_URL=postgresql+psycopg://alyvo:alyvo@postgres:5432/alyvo

# Redis
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=alyvo-demo

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=alyvo
MINIO_SECRET_KEY=alyvo-demo
MINIO_BUCKET=alyvo-documents

# Language models
LLM_PRIMARY_PROVIDER=openrouter
LLM_FALLBACK_PROVIDER=ollama
LLM_ROUTING_ENABLED=false
ALLOW_EXTERNAL_PROVIDERS=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=12
OPENROUTER_MAX_RETRIES=1

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=10

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alyvo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLING_RATE=1.0

# Embeddings
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_VECTOR_MIN_SCORE=0.76
KNOWLEDGE_INDEX_VERSION=structural-bge-m3-v1
CHUNK_PARSER_VERSION=structural-v1
# Ative somente depois de o bake-off superar +5 p.p. de nDCG@5 sem regressao
# por familia e com p95 de conhecimento <= 8 s.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# OCR
OCR_PROVIDER=paddle

# Web application
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_DOCS_ENABLED=true
