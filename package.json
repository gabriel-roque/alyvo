{
  "name": "alyvo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/docs", "packages/contracts"],
  "scripts": {
    "dev": "npm run dev --workspace @alyvo/web",
    "build": "npm run build --workspace @alyvo/web",
    "build:docs": "npm run build --workspace @alyvo/docs",
    "dev:docs": "npm run start --workspace @alyvo/docs",
    "lint": "npm run lint --workspace @alyvo/web",
    "test:web": "npm run test --workspace @alyvo/web",
    "test:e2e": "npm run test:e2e --workspace @alyvo/web",
    "typecheck": "npm run typecheck --workspace @alyvo/web && npm run typecheck --workspace @alyvo/docs",
    "generate:contracts": "npm run generate --workspace @alyvo/contracts"
  },
  "engines": {"node": ">=22", "npm": ">=10"}
}

